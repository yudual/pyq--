{
  "name": "yublog-personal",
  "version": "1.0.0",
  "private": true,
  "description": "YuBlog / Kanle Personal Blog",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:fe": "cd frontend && pnpm dev",
    "dev:be": "cd backend && pnpm dev",
    "db:pull-remote": "node scripts/sync-db-from-remote.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  }
}
